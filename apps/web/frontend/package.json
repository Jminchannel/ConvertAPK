{
  "name": "apk-converter",
  "version": "1.0.0",
  "description": "Google AI Studio Web App to APK Converter",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/app src/components/layout src/features/ui tests --max-warnings=0",
    "test:unit": "vitest run",
